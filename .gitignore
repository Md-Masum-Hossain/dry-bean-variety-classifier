# ==============================================================================
# Git Ignore - Dry Bean Variety Classification & Analytics Platform
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Node & Frontend Dependencies and Build Outputs
node_modules/
**/node_modules/
.next/
**/.next/
out/
frontend/out/
frontend/build/
*.tsbuildinfo
.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets (Exclude secrets, preserve example templates)
.env*
!.env.example
!**/.env.example

# Raw Data (Exclude bulky raw Excel/CSV dataset; keep processed data tracked)
data/raw/*
!data/raw/.gitkeep

# Explicitly Keep Machine Learning Artifacts & Processed Data Tracked in Git
!artifacts/
!artifacts/**
!data/processed/
!data/processed/**
!frontend/src/lib/
!frontend/src/lib/**

# OS & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
